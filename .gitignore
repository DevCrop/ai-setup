# Credentials and auth (never commit; docs/GUIDE.md "Troubleshooting" names these as safeguards)
.credentials*
.env*
.claude.json
# Secret file names (never commit)
*.pem
*.pem.*
*.key
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
!id_rsa*.pub
!id_ed25519*.pub
!id_ecdsa*.pub
!id_dsa*.pub
*.p12
*.pfx
*.jks
*.keystore
*credentials*.json
**/.aws/credentials
.npmrc
.netrc
.pypirc
.pgpass
.htpasswd
.git-credentials
*.tfstate
secrets.yaml
secrets.yml
# Example and template copies are not secrets (secret-guard lets them through too)
!*.example
!*.example.*
!*.sample
!*.sample.*
!*.template
!*.template.*

# Personal session state
.claude/worktrees/
.claude/handoff.md
settings.local.json
history.jsonl

# Per-machine values and reports (never commit)
/reports/
/state/
/ao/
*.lock

# OS and editor
Thumbs.db
.vscode/

# QA scratch dirs left behind by an interrupted scripts/qa-dashboard.sh
.qa-ad.*

__pycache__/
