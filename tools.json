{
  "_doc": "Tool registry read by scripts/toolreg.py (bootstrap and dashboard). Add a tool by adding one entry. Paths use tokens ${HOME} ${DOCUMENTS} ${LOCALAPPDATA} ${REPO} ${REPO_PARENT}; never a machine's absolute path. Per-machine values go in state/machine.json. Install ids and URLs were checked on 2026-10-12 (winget show --id <id> --exact; formulae.brew.sh API; URLs answer HTTP 200).",
  "tools": [
    {"id": "git", "label": "Git", "kind": "dep", "required": true, "bin": ["git"], "version": ["--version"],
     "install": {"winget": "Git.Git", "brew": "git"}},
    {"id": "python", "label": "Python", "kind": "dep", "required": true, "bin": ["python3", "python"], "version": ["--version"], "min": "3.11",
     "why": "TRACE setup.py needs 3.11+ (tomllib)", "install": {"winget": "Python.Python.3.13", "brew": "python@3.13"}},
    {"id": "node", "label": "Node.js", "kind": "dep", "required": true, "bin": ["node"], "version": ["--version"], "min": "22",
     "install": {"winget": "OpenJS.NodeJS.LTS", "brew": "node"}},
    {"id": "jq", "label": "jq", "kind": "dep", "required": true, "bin": ["jq"], "version": ["--version"],
     "why": "the status line needs it", "install": {"winget": "jqlang.jq", "brew": "jq"}},
    {"id": "gh", "label": "GitHub CLI", "kind": "dep", "required": false, "bin": ["gh"], "version": ["--version"],
     "install": {"winget": "GitHub.cli", "brew": "gh"}},
    {"id": "rtk", "label": "RTK", "kind": "dep", "required": false, "bin": ["rtk"], "version": ["--version"],
     "install": {"winget": "rtk-ai.rtk", "brew": "rtk"}},

    {"id": "claude", "label": "Claude Code", "kind": "tool", "required": true, "bin": ["claude"], "env": "CLAUDE_BIN", "version": ["--version"], "min": "2.1.295",
     "home": {"env": "CLAUDE_CONFIG_DIR", "default": "${HOME}/.claude"},
     "install": {"winget": "Anthropic.ClaudeCode", "url": "https://code.claude.com/docs/en/setup"},
     "setup": {"repo": "https://github.com/DevCrop/claude-global", "candidates": ["${REPO}"], "marker": ["scripts/apply.sh", "claude/CLAUDE.md"],
               "apply": ["bash", "scripts/apply.sh"], "verify": ["bash", "scripts/verify.sh", "--live"], "parser": "lines"}},
    {"id": "codex", "label": "Codex", "kind": "tool", "required": false, "bin": ["codex"], "env": "CODEX_BIN", "version": ["--version"],
     "home": {"env": "CODEX_HOME", "default": "${HOME}/.codex"},
     "install": {"winget": "OpenAI.Codex", "url": "https://github.com/openai/codex"},
     "setup": {"repo": "https://github.com/DevCrop/codex-setup", "env": "TRACE_DIR", "legacy": "state/trace-dir.txt",
               "candidates": ["${DOCUMENTS}/ChatGPT/글로벌 셋업/codex-setup", "${REPO_PARENT}/codex-setup", "${HOME}/codex-setup"],
               "marker": ["scripts/setup.py", "manifest.json"], "python": true,
               "plan": ["scripts/setup.py", "plan"], "apply": ["scripts/setup.py", "apply"], "verify": ["scripts/setup.py", "verify"], "parser": "trace"}},
    {"id": "ao", "label": "Agent Orchestrator", "kind": "tool", "required": false, "bin": ["ao"], "env": "AO_BIN",
     "paths": ["${LOCALAPPDATA}/Programs/agent-orchestrator/resources/daemon/ao.exe"],
     "home": {"default": "${HOME}/.ao"},
     "install": {"url": "https://github.com/aoagents/agent-orchestrator"},
     "note": "Setup and project registration live in the private repo DevCrop/ao-work-history (setup/setup.py)."},
    {"id": "cursor", "label": "Cursor", "kind": "tool", "required": false, "bin": ["cursor"], "env": "CURSOR_BIN", "version": ["--version"],
     "paths": ["${LOCALAPPDATA}/Programs/cursor/Cursor.exe", "/Applications/Cursor.app"],
     "home": {"default": "${HOME}/.cursor"},
     "install": {"winget": "Anysphere.Cursor", "cask": "cursor"},
     "note": "Detection only for now; no setup repo."}
  ]
}
