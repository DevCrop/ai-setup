{
  "_doc": "Tool registry read by scripts/toolreg.py (bootstrap and dashboard). Add a tool by adding one entry. Paths use tokens ${HOME} ${LOCALAPPDATA} ${REPO}; never a path inside one user's home. Per-machine values go in state/machine.json. A setup with \"inRepo\": true is a folder of this repo: only its candidates are used (machine.json checkout is not read). Install ids and URLs were checked on 2026-10-12 (winget show --id <id> --exact; URLs answer HTTP 200).",
  "tools": [
    {"id": "git", "label": "Git", "kind": "dep", "required": true, "bin": ["git"], "version": ["--version"],
     "install": {"winget": "Git.Git"}},
    {"id": "python", "label": "Python", "kind": "dep", "required": true, "bin": ["python3", "python"], "version": ["--version"], "min": "3.11",
     "why": "TRACE setup.py needs 3.11+ (tomllib)", "install": {"winget": "Python.Python.3.13"}},
    {"id": "node", "label": "Node.js", "kind": "dep", "required": true, "bin": ["node"], "version": ["--version"], "min": "22",
     "install": {"winget": "OpenJS.NodeJS.LTS"}},
    {"id": "jq", "label": "jq", "kind": "dep", "required": true, "bin": ["jq"], "version": ["--version"],
     "why": "the status line needs it", "install": {"winget": "jqlang.jq"}},
    {"id": "gh", "label": "GitHub CLI", "kind": "dep", "required": false, "bin": ["gh"], "version": ["--version"],
     "install": {"winget": "GitHub.cli"}},
    {"id": "rtk", "label": "RTK", "kind": "dep", "required": false, "bin": ["rtk"], "version": ["--version"],
     "install": {"winget": "rtk-ai.rtk"}},

    {"id": "claude", "label": "Claude Code", "kind": "tool", "required": true, "bin": ["claude"], "env": "CLAUDE_BIN", "version": ["--version"], "min": "2.1.295",
     "home": {"env": "CLAUDE_CONFIG_DIR", "default": "${HOME}/.claude"},
     "install": {"winget": "Anthropic.ClaudeCode", "url": "https://code.claude.com/docs/en/setup"},
     "setup": {"repo": "https://github.com/DevCrop/ai-setup", "candidates": ["${REPO}"], "marker": ["scripts/apply.sh", "claude/CLAUDE.md"],
               "plan": ["bash", "scripts/apply.sh", "--dry-run"], "apply": ["bash", "scripts/apply.sh"], "verify": ["bash", "scripts/verify.sh", "--live"], "parser": "lines"}},
    {"id": "codex", "label": "Codex", "kind": "tool", "required": false, "bin": ["codex"], "env": "CODEX_BIN", "version": ["--version"],
     "home": {"env": "CODEX_HOME", "default": "${HOME}/.codex"},
     "install": {"winget": "OpenAI.Codex", "url": "https://github.com/openai/codex"},
     "setup": {"repo": "https://github.com/DevCrop/ai-setup", "inRepo": true,
               "candidates": ["${REPO}/codex"],
               "marker": ["scripts/setup.py", "manifest.json"], "python": true,
               "plan": ["scripts/setup.py", "plan"], "apply": ["scripts/setup.py", "apply"], "verify": ["scripts/setup.py", "verify"], "parser": "trace"}},
    {"id": "ao", "label": "Agent Orchestrator", "kind": "tool", "required": false, "bin": ["ao"], "env": "AO_BIN",
     "paths": ["${LOCALAPPDATA}/Programs/agent-orchestrator/resources/daemon/ao.exe"],
     "home": {"default": "${HOME}/.ao"},
     "install": {"url": "https://github.com/OrchestratorInc/agent-orchestrator"},
     "note": "Setup and project registration: ao/setup.py, run by hand (needs the AO app running; docs/GUIDE.md)."}
  ]
}
