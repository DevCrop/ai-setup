{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "opus",
  "outputStyle": "Concise",
  "agentPushNotifEnabled": true,
  "autoCompactWindow": 400000,
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "enableWorkflows": true,
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline.sh\"",
    "refreshInterval": 30
  },
  "permissions": {
    "allow": [],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/compact-context.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/config-audit.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "settings",
        "name": "ponytail",
        "owner": {
          "name": "DevCrop"
        },
        "plugins": [
          {
            "name": "ponytail",
            "source": {
              "source": "url",
              "url": "https://github.com/DietrichGebert/ponytail.git",
              "ref": "v5.3.2",
              "sha": "16352ac229eb08a9598dcae48fe9f2b342567d86"
            }
          }
        ]
      }
    },
    "thedotmack": {
      "source": {
        "source": "settings",
        "name": "thedotmack",
        "owner": {
          "name": "DevCrop"
        },
        "plugins": [
          {
            "name": "claude-mem",
            "source": {
              "source": "git-subdir",
              "url": "https://github.com/thedotmack/claude-mem.git",
              "path": "plugin",
              "ref": "v14.0.0",
              "sha": "f6a701a35504bb089452522b1101fab475720ea7"
            }
          }
        ]
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "claude-mem@thedotmack": true,
    "desktop-commander@synced": false
  }
}
