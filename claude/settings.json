{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "opus",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "outputStyle": "Concise",
  "agentPushNotifEnabled": true,
  "autoCompactWindow": 400000,
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "enableWorkflows": true,
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline.sh\"",
    "refreshInterval": 30
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Read(//**/.env*)",
      "Read(//**/.credentials*)",
      "Bash(rtk read *.env*)",
      "Bash(rtk read *.credentials*)",
      "Bash(rtk grep * .env*)",
      "Bash(rtk grep * */.env*)",
      "Bash(rtk grep * *.credentials*)",
      "Bash(rtk rg * .env*)",
      "Bash(rtk rg * */.env*)",
      "Bash(rtk rg * *.credentials*)",
      "Bash(rtk bypass * .env*)",
      "Bash(rtk bypass * */.env*)",
      "Bash(rtk bypass * *.credentials*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/compact-context.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/config-audit.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "settings",
        "name": "ponytail",
        "owner": {
          "name": "DevCrop"
        },
        "plugins": [
          {
            "name": "ponytail",
            "source": {
              "source": "url",
              "url": "https://github.com/DietrichGebert/ponytail.git",
              "ref": "v5.3.3",
              "sha": "7801d061243d7b753bad0e0b3c057cd250b11755"
            }
          }
        ]
      }
    },
    "thedotmack": {
      "source": {
        "source": "settings",
        "name": "thedotmack",
        "owner": {
          "name": "DevCrop"
        },
        "plugins": [
          {
            "name": "claude-mem",
            "source": {
              "source": "git-subdir",
              "url": "https://github.com/thedotmack/claude-mem.git",
              "path": "plugin",
              "ref": "v15.8.0",
              "sha": "9e67b7641af6e9378b32dc08441bb1caabebc117"
            }
          }
        ]
      }
    },
    "tokeneconomizer": {
      "source": {
        "source": "settings",
        "name": "tokeneconomizer",
        "owner": {
          "name": "DevCrop"
        },
        "plugins": [
          {
            "name": "tokeneconomizer",
            "source": {
              "source": "git-subdir",
              "url": "https://github.com/microsoft/TokenEconomizer.git",
              "path": "plugin",
              "ref": "main",
              "sha": "e428fc91b0f8ffecb5a596d56b14fe2f1485a5f9"
            }
          }
        ]
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "claude-mem@thedotmack": true,
    "tokeneconomizer@tokeneconomizer": true,
    "desktop-commander@synced": false
  },
  "tui": "fullscreen",
  "autoUpdatesChannel": "latest",
  "skipWorkflowUsageWarning": true
}
