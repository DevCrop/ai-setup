    "allow": [],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: personal (DevCrop). Primary use: software development and maintaining this Claude Code setup",
      "Source control: github.com/DevCrop and all repos under it",
      "Plugin supply chain: Claude Code plugins come from the marketplaces already listed in extraKnownMarketplaces; adding another marketplace or plugin needs the user to name it"
    ],
    "soft_deny": [
      "$defaults",
      "Installing, updating, or adding Claude Code plugins, marketplaces, or skills (claude plugin install/update, claude plugin marketplace add, npx skills add) unless the user named that exact action"
    ],
    "hard_deny": [
      "$defaults",
      "Printing, copying, or sending the contents of real secret files: .env*, .credentials*, credentials.json, private keys (id_rsa*, id_ed25519*, *.pem, *.key). Files ending in .example, .sample or .template are not secrets"
    ]
  },
  "skillOverrides": {
    "auto-mode-setup": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/secret-guard.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "claude-mem@thedotmack": true,
    "desktop-commander@synced": false
  }
}
