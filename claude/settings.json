{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus[1m]",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "opus",
  "outputStyle": "Concise",
  "agentPushNotifEnabled": true,
  "autoCompactWindow": 400000,
  "promptCacheTtl": "1h",
  "subagentPromptCacheTtl": "1h",
  "enableWorkflows": true,
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/statusline.sh\"",
    "refreshInterval": 30
  },
  "permissions": {
    "allow": [],
    "defaultMode": "auto"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: personal (DevCrop). Primary use: software development and maintaining this Claude Code setup",
      "Source control: github.com/DevCrop and all repos under it",
      "Plugin supply chain: Claude Code plugins come only from the inline marketplaces in extraKnownMarketplaces, each pinned to a full commit sha; changing a pin, adding a marketplace or adding a plugin needs the user to name it"
    ]
  },
  "skillOverrides": {
    "auto-mode-setup": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/compact-context.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hooks/config-audit.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "settings",
        "name": "ponytail",
        "owner": {
          "name": "DevCrop"
        },
        "plugins": [
          {
            "name": "ponytail",
            "source": {
              "source": "url",
              "url": "https://github.com/DietrichGebert/ponytail.git",
              "ref": "v5.2.0",
              "sha": "2961b52fc1fe6a5a87c7a959a79512e5c2f3ffe5"
            }
          }
        ]
      }
    },
    "thedotmack": {
      "source": {
        "source": "settings",
        "name": "thedotmack",
        "owner": {
          "name": "DevCrop"
        },
        "plugins": [
          {
            "name": "claude-mem",
            "source": {
              "source": "git-subdir",
              "url": "https://github.com/thedotmack/claude-mem.git",
              "path": "plugin",
              "ref": "v13.37.0",
              "sha": "b2756eb31740143e6f464bf65d9f9c766402efc6"
            }
          }
        ]
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "claude-mem@thedotmack": true,
    "desktop-commander@synced": false
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
